# Copy to .env and fill in values. Never commit .env.

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated list of Google account emails allowed to log in.
# Leave empty to allow any verified Google account.
ALLOWED_EMAILS=

# Public URL of this deployment (used to build the OAuth redirect URI).
EXTERNAL_URL=http://localhost:3000

# Set to "false" to disable login entirely (open access).
REQUIRE_AUTH=true

# Random secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET_KEY=

# Twitter/X auth cookies (from browser dev tools: F12 > Application > Cookies > x.com).
# When set, captures of x.com/twitter.com URLs are made while logged in, which
# avoids the logged-out "teaser" page and its non-scrollable layout.
TWITTER_AUTH_TOKEN=
TWITTER_CT0=
